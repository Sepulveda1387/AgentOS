# AgentOS Environment Variables
# Copy this file to .env and fill in values locally. Never commit .env.

# ── Tool Integrations (add only what you use) ──────────────────────────────

# Google Workspace
# GOOGLE_WORKSPACE_AUTH_MODE=oauth          # or service_account
# GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account.json

# Notion
# NOTION_API_KEY=

# Linear / Jira / ClickUp
# LINEAR_API_KEY=
# JIRA_URL=
# JIRA_TOKEN=
# CLICKUP_API_TOKEN=

# GitHub
# GITHUB_TOKEN=

# Slack
# SLACK_BOT_TOKEN=

# CRM (GoHighLevel, HubSpot, Salesforce, Pipedrive, etc.)
# CRM_API_KEY=
# CRM_BASE_URL=

# Search / Research
# BRAVE_SEARCH_API_KEY=
# OPENROUTER_API_KEY=

# AI / LLM
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── System ─────────────────────────────────────────────────────────────────

# AGENT_OS_NAME=AgentOS      # Rename to match your workspace
# AGENT_OS_OWNER=                # Your name or team name
